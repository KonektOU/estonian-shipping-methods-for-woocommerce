msgstr "Tähestikuliselt"

#: includes/abstracts/class-wc-estonian-shipping-method-terminals.php:133
msgid "Bigger cities first, then alphabetically the rest"
msgstr "Suuremad linnad ees"

#: includes/abstracts/class-wc-estonian-shipping-method-terminals.php:137
msgid "Group terminals"
msgstr "Grupeeri automaadid"

#: includes/abstracts/class-wc-estonian-shipping-method-terminals.php:141
msgid "By cities"
msgstr "Linna järgi"

