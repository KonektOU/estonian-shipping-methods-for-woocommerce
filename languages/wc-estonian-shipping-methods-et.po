#: assets/js/checkout-block-editor.js:19 assets/js/checkout-block-editor.js:40
#: assets/js/checkout-block.js:52
msgid "Parcel terminal"
msgstr "Pakiautomaat"

#: assets/js/checkout-block-editor.js:23
msgid ""
"Lets the customer choose a parcel terminal for the shipping method they "
"picked."
msgstr "Laseb kliendil valitud tarneviisile pakiautomaadi valida."

#: assets/js/checkout-block-editor.js:44
msgid ""
"A terminal list is shown here when the customer chooses a shipping method "
"that delivers to parcel terminals."
msgstr ""
"Siin kuvatakse pakiautomaatide nimekiri, kui klient valib pakiautomaati "
"toimetava tarneviisi."

