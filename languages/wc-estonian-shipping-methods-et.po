#: includes/abstracts/class-wc-estonian-shipping-method-terminals.php:920
#, php-format
msgid "Terminal #%s"
msgstr "Pakiautomaat #%s"

#: includes/abstracts/class-wc-estonian-shipping-method.php:97
msgid "Title"
msgstr "Pealkiri"

#: includes/abstracts/class-wc-estonian-shipping-method.php:99
msgid "This controls the title which user sees during checkout."
msgstr "See määrab nimetuse, mida kasutaja kassas näeb."

#: includes/abstracts/class-wc-estonian-shipping-method.php:104
msgid "Shipping price"
msgstr "Saatekulu"

#: includes/abstracts/class-wc-estonian-shipping-method.php:107
msgid "Without taxes"
msgstr "Ilma maksudeta"

#: includes/abstracts/class-wc-estonian-shipping-method.php:112
msgid "Free shipping amount"
msgstr "Tasuta tarne summa"

#: includes/abstracts/class-wc-estonian-shipping-method.php:115
msgid ""
"Shipping will be free of charge, if order total is equal or bigger than this "
"value. Zero will disable free shipping."
msgstr ""
"Tarne on kliendile tasuta juhul kui tellimuse kogusumma on võrdne või suurem "
"kui siin määratud summa. Väärtus 0 (null) tühistab tasuta tarne võimaluse."

#: includes/abstracts/class-wc-estonian-shipping-method.php:120
msgid "Enable free shipping coupons"
msgstr "Luba tasuta tarne kupongid"

#: includes/abstracts/class-wc-estonian-shipping-method.php:123
msgid "Enable"
msgstr "Aktiveeri"

#: includes/abstracts/class-wc-estonian-shipping-method.php:124
#, php-format
msgid ""
"Enable this if you want to make this shipping method free of charge when "
"free shipping coupon is applied to customer&rsquo;s cart. Read more about "
"free shipping and coupons from %s."
msgstr ""
"Aktiveerimisel arvestatakse ostukorvis ning kassas ostukorvile lisatud "
"tasuta tarne kupongi. Juhul kui kupong on rakendatud, siis tarnemeetodi "
"saatekulu nullitakse. Loe lähemalt tasuta tarne kupongist %s."

#: includes/abstracts/class-wc-estonian-shipping-method.php:124
msgid "WooCommerce&rsquo;s documentation"
msgstr "WooCommerce dokumentatsioonist"

#: includes/abstracts/class-wc-estonian-shipping-method.php:127
msgid "Only for shipping classes"
msgstr "Ainult nendele tarneklassidele"

#: includes/abstracts/class-wc-estonian-shipping-method.php:133
msgid ""
"Offer this method only when everything in the cart is in one of these "
"classes. Leave empty to offer it for everything."
msgstr ""
"Paku seda tarneviisi ainult siis, kui kõik ostukorvi tooted kuuluvad mõnda "
"neist klassidest. Jäta tühjaks, et pakkuda kõigile."

#. translators: %s: the shop's weight unit, e.g. kg.
#: includes/abstracts/class-wc-estonian-shipping-method.php:139
#, php-format
msgid "Maximum cart weight (%s)"
msgstr "Ostukorvi suurim kaal (%s)"

#: includes/abstracts/class-wc-estonian-shipping-method.php:144
msgid "No limit"
msgstr "Piiranguta"

#: includes/abstracts/class-wc-estonian-shipping-method.php:145
msgid ""
"Hide this method when the cart weighs more than this. A parcel terminal will "
"not take everything a courier will. Leave empty for no limit."
msgstr ""
"Peida see tarneviis, kui ostukorv kaalub rohkem. Pakiautomaati ei mahu kõik, "
"mida kuller vedada saab. Jäta tühjaks, kui piirangut pole."

#: includes/abstracts/class-wc-estonian-shipping-method.php:149
msgid "Tax status"
msgstr "Maksud"

#: includes/abstracts/class-wc-estonian-shipping-method.php:156
msgid "Whether VAT is added to the shipping cost. Shipping is usually taxable."
msgstr "Kas saatekulule lisandub käibemaks. Tavaliselt lisandub."

#: includes/abstracts/class-wc-estonian-shipping-method.php:159
msgid "Taxable"
msgstr "Lisatakse juurde"

#: includes/abstracts/class-wc-estonian-shipping-method.php:160
msgid "None"
msgstr "Ilma maksudeta"

#: includes/abstracts/class-wc-estonian-shipping-method.php:422
#: includes/class-wc-esm-checkout-phone.php:58
msgid "Please add country prefix to the phone number (eg. +372)."
msgstr "Palun lisage telefoni numbrile riigi eesliide (näiteks +372)."

#: includes/class-wc-esm-checkout-phone.php:54
msgid ""
"Please enter a phone number: the pickup code for your parcel is sent to it."
msgstr ""
"Palun sisestage telefoninumber: sellele saadetakse teie paki kättesaamise "
"kood."

#: includes/class-wc-estonian-shipping-blocks.php:140
msgid "Shipping method the terminals belong to."
msgstr "Tarneviis, mille pakiautomaadid need on."

#: includes/class-wc-estonian-shipping-blocks.php:145
msgid "Name the chosen terminal is stored under."
msgstr "Nimi, mille all valitud pakiautomaat salvestatakse."

#: includes/class-wc-estonian-shipping-blocks.php:150
msgid "Label for the terminal selection."
msgstr "Pakiautomaadi valiku pealkiri."

#: includes/class-wc-estonian-shipping-blocks.php:155
msgid "Terminals, grouped the way the shipping method groups them."
msgstr "Pakiautomaadid, rühmitatud nii, nagu tarneviis neid rühmitab."

#: includes/class-wc-estonian-shipping-blocks.php:160
msgid "Terminal chosen so far."
msgstr "Seni valitud pakiautomaat."

#: includes/class-wc-estonian-shipping-blocks.php:184
msgid "Chosen terminal."
msgstr "Valitud pakiautomaat."

