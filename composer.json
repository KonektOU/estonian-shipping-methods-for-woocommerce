{
    "name": "konekt/estonian-shipping-methods-for-woocommerce",
    "description": "Extends WooCommerce with most commonly used Estonian shipping methods.",
    "keywords": ["woocommerce", "shipping"],
    "type": "wordpress-plugin",
    "authors": [
        {
            "name": "Konekt OÜ",
            "email": "info@konekt.ee"
        }
    ],
    "require": {
        "php": ">=7.4",
        "composer/installers": "~1.0",
        "setasign/fpdi": "^2.3",
        "setasign/fpdf": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6",
        "symfony/polyfill-mbstring": "^1.38"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
